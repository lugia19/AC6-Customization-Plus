profileVersion = "v1"

# Customization Plus: more to set in the Paint screen (thruster color and flame type, expansion color, HUD colors and
# opacity, light brightness, melee weapon colors).
# Paths are relative to this file (the package folder build.py writes).

# Modded play uses its own save: me3 copies the real save to this file on first launch and never touches the original.
savefile = "CustomizationPlus.sl2"

# The game's Arxan protection puts back code it guards, which silently removes hooks mid-session (it took the
# player's flames back to stock). me3 neutralizes it.
disable_arxan = true

[[supports]]
game = "armoredcore6"

[[packages]]
id = "customization-plus"
path = 'mod'

[[natives]]
path = 'customization_plus.dll'
