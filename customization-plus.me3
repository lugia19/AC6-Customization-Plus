profileVersion = "v1"

# Customization Plus: more to set in the Paint screen (thruster color, HUD colors and opacity, light brightness).
# Paths are relative to this file (the package folder build.py writes).

# Modded play uses its own save: me3 copies the real save to this file on first launch and never touches the original.
savefile = "CustomizationPlus.sl2"

[[supports]]
game = "armoredcore6"

[[packages]]
id = "customization-plus"
path = 'mod'

[[natives]]
path = 'customization_plus.dll'
